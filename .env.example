# Supabase (Configuración del proyecto > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key de Supabase (Configuración del proyecto > API > service_role).
# NUNCA se expone al navegador (sin prefijo NEXT_PUBLIC_) -- solo la usan
# rutas server-side, como /api/auth/login para el rate limiting del login.
SUPABASE_SERVICE_ROLE_KEY=
